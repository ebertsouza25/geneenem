# Configuração da GeneIA (OpenAI ou provedor compatível).
#
# 1. Copie este arquivo para ia/.env
# 2. Escolha um provedor abaixo e cole a chave em OPENAI_API_KEY
# 3. Rode: php ia/diagnostico.php
#
# O arquivo ia/.env NÃO deve ser enviado ao repositório nem aberto no navegador.
# Quem preenche é o responsável pelo servidor; o aluno nunca vê estes valores.
#
# ---------------------------------------------------------------- Google Gemini
# Gratuito, sem cartão de crédito: https://aistudio.google.com/apikey
# (o nível gratuito permite ~500 pedidos/dia e limita requisições por minuto)
OPENAI_API_KEY=COLE_SUA_CHAVE_AQUI
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.8-flash
OPENAI_API_MODE=chat
#
# ------------------------------------------------------------------- OpenAI pago
# Descomente e apague o bloco do Gemini para usar a OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-luna
# OPENAI_MODEL_FALLBACKS=gpt-6.1-terra,gpt-6.1-sol
# OPENAI_API_MODE=responses
# OPENAI_REASONING_EFFORT=low
# OPENAI_STORE=false
#
# ----------------------------------------------------------------------- Groq
# Gratuito, sem cartão: https://console.groq.com/keys
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_API_MODE=chat
